module PassThrough {
    ports: [
        mainInputPort {
            block: Input
        }
        mainOutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input { type: _RealType }
        signal Output { type: _RealType }
    ]
    streams: [
        Input >> Output;
    ]
}

signal OuterInput {}
signal OuterOutput {}

## This stream must be in line 23
OuterInput >> PassThrough() >> OuterOutput;