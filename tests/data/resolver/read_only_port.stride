module PassThrough {
    ports: [
        # type is read only on ports. It belongs on the block declaration.
        mainInputPort InputPort { block: Input type: _IntType }
        mainOutputPort OutputPort { block: Output }
    ]
    blocks: [
        signal Input { type: _IntType }
        signal Output { type: _IntType }
    ]
    streams: [
        Input >> Output;
    ]
}

signal In { type: _IntType }
signal Out { type: _IntType }

In >> PassThrough() >> Out;
